# Copy to backend/.env (or UthaLe/.env). Real environment variables take precedence.

# --- Camera ---------------------------------------------------------------
# OpenCV device index. Indices shift when cameras are plugged/unplugged and
# virtual cameras (OBS, Snap Camera, ...) take indices too.
CAMERA_INDEX=0
# auto = DirectShow on Windows, OpenCV default elsewhere. Options: auto|dshow|msmf|v4l2|avfoundation|any
CAMERA_BACKEND=auto
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=15
CAMERA_JPEG_QUALITY=80
CAMERA_AUTOSTART=1
# Burn a "UthaLe CAM<n> <timestamp>" label into frames
CAMERA_OVERLAY=1

# --- Robot simulation (no hardware adapter exists yet) --------------------
ROBOT_ADAPTER=simulated
# >1 runs simulated steps faster (e.g. 3 for a snappy demo)
SIM_SPEED=1.0
# Chance that an order line gets a random simulated anomaly (0 disables)
SIM_ANOMALY_RATE=0.15
# Simulated NFC + load-cell readings. 0 = no sensors -> every placement goes to REVIEW
SIM_SENSORS=1
# Fix the RNG for reproducible demos
# SIM_SEED=42

# --- Storage --------------------------------------------------------------
# DB_PATH=backend/data/uthale.db
# EVIDENCE_DIR=backend/data/evidence
# INVENTORY_PATH=../config/inventory.yaml

# --- Server ---------------------------------------------------------------
# HOST=127.0.0.1
# PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
